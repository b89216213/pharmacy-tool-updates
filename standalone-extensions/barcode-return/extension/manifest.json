{
  "manifest_version": 3,
  "name": "刷條碼退藥輔助",
  "version": "1.5.4",
  "description": "在院內刷條碼退藥頁面，自動讀取處方與發退藥紀錄、全選處方，手動輸入並確認退藥。",
  "minimum_chrome_version": "122",
  "action": {
    "default_title": "刷條碼退藥：開啟／關閉",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://ihisaw.ntuh.gov.tw/WebApplication/PharManagement/BarCodeDrugReturn.aspx*"
      ],
      "js": [
        "page-bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://ihisaw.ntuh.gov.tw/WebApplication/PharManagement/BarCodeDrugReturn.aspx*"
      ],
      "js": [
        "core.js",
        "workflow.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "permissions": [
    "storage",
    "tabs",
    "webNavigation",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://ihisaw.ntuh.gov.tw/*",
    "https://raw.githubusercontent.com/*",
    "https://pharmacy-device-console.cx760.chatgpt.site/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "manager.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'self' https://raw.githubusercontent.com https://pharmacy-device-console.cx760.chatgpt.site; base-uri 'none'; form-action 'none'"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*"
      ],
      "matches": [
        "https://ihisaw.ntuh.gov.tw/*"
      ]
    }
  ],
  "version_name": "1.5.4"
}
