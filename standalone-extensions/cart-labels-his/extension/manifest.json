{
  "manifest_version": 3,
  "name": "藥車標籤列印（HIS 擴充）",
  "version": "2.17.0",
  "description": "自動擷取病房與預覽藥車標籤，依交車日紀錄比對，支援早晚病房組合與本機紀錄。",
  "permissions": [
    "storage",
    "scripting",
    "tabs",
    "webNavigation"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "藥車標籤列印",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.ntuh.gov.tw/WebApplication/*",
        "http://*.ntuh.gov.tw/WebApplication/*"
      ],
      "js": [
        "arm.js",
        "content.js",
        "capture.js"
      ],
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "minimum_chrome_version": "116",
  "host_permissions": [
    "https://*.ntuh.gov.tw/*",
    "http://*.ntuh.gov.tw/*",
    "https://pharmacy-device-console.cx760.chatgpt.site/*",
    "https://raw.githubusercontent.com/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "version_name": "2.17.0",
  "options_ui": {
    "page": "labels/index.html",
    "open_in_tab": true
  }
}
